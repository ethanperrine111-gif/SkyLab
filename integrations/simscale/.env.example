# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# SimScale API — get this from Manage Account → API Keys on simscale.com.
# Requires an Enterprise plan for API access.
SIMSCALE_API_KEY=

# SimScale API host. Leave as-is unless SimScale support has told you otherwise.
SIMSCALE_HOST=https://api.simscale.com

# Anthropic API key — only needed if you run the orchestrator example
# (mcp_server.py itself does not talk to Claude directly; the Claude Desktop
# app or another MCP client does).
ANTHROPIC_API_KEY=
